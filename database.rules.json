{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('players').child(auth.uid).exists() || newData.child('players').child(auth.uid).exists())",
        ".validate": "!newData.exists() || !newData.child('players').exists() || newData.child('players').numChildren() <= 6"
      }
    }
  }
}
